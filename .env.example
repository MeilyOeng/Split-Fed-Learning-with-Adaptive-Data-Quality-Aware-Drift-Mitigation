# Split learning runtime configuration
# Exported shell variables override values from this file.

CLUSTER_IDS=1
RUN_CLUSTERS_IN_PARALLEL=false

# Orchestration / ports
STREAM_BASE_PORT=5101
SERVER_BASE_PORT=5002
CLIENT_WORKER_BASE_PORT=6101
CLIENT_METRICS_BASE=9100

# Training schedule
TRAINING_MODE=client_batch_random
NUM_EPOCHS=1
LOCAL_EPOCHS_PER_GLOBAL_ROUND=1
BATCH_SIZE=32
RANDOM_SEED=42
RANDOM_SEED_SCHEDULE=42
# fixed | random_per_round | round_robin
CLIENT_ORDER_STRATEGY=random_per_round

# Optimizers / round chunking
CLIENT_LR=0.001
SERVER_LR=0.0003
# In persistent-worker mode, this sets the maximum number of clients per server round chunk.
ACCUM_STEPS_SERVER=21
CHECKPOINT_EVERY_ROUNDS=50

# Evaluation / stopping
# final_shared | paired_best | latest
EVAL_MODE=final_shared
EARLY_STOPPING=true
EARLY_STOPPING_PATIENCE=15
EARLY_STOPPING_MIN_DELTA=0.00001
EARLY_STOPPING_METRIC=val_raw_mae

# Data sources
# *_CLUSTER_DATA_DIR controls input windows X.
# *_TARGET_CLUSTER_DATA_DIR controls labels y; defaults to the matching input directory.
# For faulty-input/clean-label experiments, point input dirs to faulty data and target dirs to clean data.
CLUSTER_DATA_DIR=dataset/output
TRAIN_CLUSTER_DATA_DIR=dataset/output
VAL_CLUSTER_DATA_DIR=dataset/output
TEST_CLUSTER_DATA_DIR=dataset/output
TRAIN_TARGET_CLUSTER_DATA_DIR=dataset/output
VAL_TARGET_CLUSTER_DATA_DIR=dataset/output
TEST_TARGET_CLUSTER_DATA_DIR=dataset/output

# Logging / runtime I/O
COMM_LOG_TRAIN=true
COMM_LOG_EVAL=false
COMM_LOG_STREAM=false
# Log every Nth batch instead of every batch.
COMM_LOG_EVERY_N_BATCHES=50
# Save client progress every Nth batch. Forced saves still happen at stream start and epoch end.
SAVE_PROGRESS_EVERY_N_BATCHES=50
# Skip the duplicated aggregated raw communication_log.csv in results/.
WRITE_COMMUNICATION_LOG=false

# Model
MODEL_INPUT_SIZE=1
MODEL_HIDDEN_SIZE=128
MODEL_NUM_LAYERS=3
MODEL_SPLIT_LAYER=2
MODEL_OUTPUT_SIZE=1
MODEL_DROPOUT=0.4
MODEL_BIDIRECTIONAL=false
AUTO_MODEL_INPUT_SIZE=true

# Optional static metadata features from clustering preprocessing.
# false -> demand only, input size forced to 1
# true  -> demand + static features from dataset/output/feature_manifest.json
USE_STATIC_FEATURES=false
# Optional shortcut groups: numeric, category, subcategory, categorical, all
# Example:
# STATIC_FEATURE_GROUPS=numeric,subcategory
STATIC_FEATURE_GROUPS= numeric,subcategory
# Leave empty to use all static features when enabled.
# Or provide a comma-separated subset, for example.
# Use either STATIC_FEATURE_GROUPS or STATIC_FEATURE_COLUMNS, not both:
# STATIC_FEATURE_COLUMNS=meta_num_sum_kwh,meta_num_max,meta_cat_categoria_industrial
# STATIC_FEATURE_COLUMNS= 

# Quality usage modes
# Independent DQ switches:
# - USE_QUALITY_AS_INPUT appends offline window DQ scores as client-side input features.
# - USE_QUALITY_WEIGHTS applies the existing per-window weighted server loss.
# - USE_QUALITY_AGGREGATION_WEIGHTS applies soft client-level split-server gradient aggregation.
# DQ mode examples:
# none: all three flags false
# input_feature: USE_QUALITY_AS_INPUT=true
# window_loss_weight: USE_QUALITY_WEIGHTS=true
# soft_client_gradient_weight: USE_QUALITY_AGGREGATION_WEIGHTS=true
# input_feature_and_soft_client_gradient_weight: input + aggregation
# Combining USE_QUALITY_WEIGHTS and USE_QUALITY_AGGREGATION_WEIGHTS is experimental and may double-count quality.
USE_QUALITY_WEIGHTS=false
USE_QUALITY_AS_INPUT=false
USE_QUALITY_AGGREGATION_WEIGHTS=false

# Stage-one relative high-quality anchor aggregation.
# USE_QUALITY_ANCHOR_AGGREGATION is mutually exclusive with all three legacy quality modes above.
USE_QUALITY_ANCHOR_AGGREGATION=false
USE_GRADIENT_ALIGNMENT_FILTER=false
# Parsed deliberately, but reserved until the separately approved validation-guardrail stage.
USE_HIGH_QUALITY_VALIDATION_GUARDRAIL=false
QUALITY_ANCHOR_TOP_FRACTION=0.40
QUALITY_ANCHOR_MIN_CLIENTS=3
QUALITY_ANCHOR_UPDATE_SHARE=0.80
QUALITY_ALIGNMENT_POWER=1.0
# 0.0 implements positive-only alignment: max(0, cosine).
QUALITY_NEGATIVE_ALIGNMENT_WEIGHT=0.0
# Each non-anchor norm is capped at this multiple of the anchor-gradient norm.
QUALITY_LOW_CLIENT_NORM_CAP=2.0
QUALITY_ANCHOR_EPS=1e-8
# Adds per-non-anchor alignment records to quality_anchor_aggregation.jsonl.
QUALITY_AGGREGATION_DEBUG_LOG=false

QUALITY_AGGREGATION_MODE=soft_client_gradient
QUALITY_AGGREGATION_Q_MIN=0.5
QUALITY_AGGREGATION_EPS=1e-8
# Required when any legacy quality mode or USE_QUALITY_ANCHOR_AGGREGATION is true
QUALITY_SCORE_PATH=
STRICT_QUALITY_SCORE_MATCHING=true
QUALITY_SCORE_FALLBACK=1.0

# Windowing / normalization
WINDOW_SIZE=24
FORECAST_HORIZON=1
TRAIN_RATIO=0.7
VAL_RATIO=0.1
TEST_RATIO=0.2
NORMALIZE=true
NORMALIZE_METHOD=zscore
NORMALIZE_EPS=1e-8
SIGN_FLIP=true

# GPU placement
GPU_ENABLED=true
# GPU_ID=
# SERVER_GPU_ID=
# SERVER_GPU_IDS=0,1,2,3
# CLIENT_GPU_ID=
# CLIENT_GPU_IDS=0,1,2,3
# CUDA_VISIBLE_DEVICES=0,1,2,3

# Optional raw-timeline drift validation (all disabled by default).
FROZEN_VALIDATION_MODE=false
SKIP_TRAINING=false
# Preferred schema-v2 raw-timeline configuration. Leave empty for the legacy adapter.
# DRIFT_CONFIG_PATH is mutually exclusive with DRIFT_INJECTION_ENABLED=true.
DRIFT_CONFIG_PATH=
# Legacy scalar adapter below: historical DRIFT_SOURCE=input is accepted but is
# explicitly recorded as measurement drift.
DRIFT_INJECTION_ENABLED=false
DRIFT_DETECTION_ENABLED=false
# Correct legacy-adapter name; "input" remains an accepted deprecated alias.
DRIFT_SOURCE=measurement
DRIFT_SCOPE=test
DRIFT_RUN_ID=drift-validation
DRIFT_CONFIGURATION_ID=default
DRIFT_CLIENT_IDS=
DRIFT_CLIENT_FRACTION=0.5
DRIFT_RANDOM_SEED=42
DRIFT_TYPE=sudden
DRIFT_MAGNITUDE=0.5
DRIFT_OFFSET_DELTA=0.0
DRIFT_NOISE_SIGMA=0.0
DRIFT_TRANSITION=linear
DRIFT_START_RATIO=0.5
DRIFT_END_RATIO=
DRIFT_PERIOD=168
DRIFT_DETECTORS=page_hinkley,adwin
DRIFT_EVENT_BUFFER_SIZE=4096
PH_MIN_INSTANCES=300
PH_DELTA=0.005
PH_THRESHOLD=50.0
PH_ALPHA=0.9999
ADWIN_DELTA=0.002
ADWIN_CLOCK=32
ADWIN_MAX_BUCKETS=5
ADWIN_MIN_WINDOW_LENGTH=5
ADWIN_GRACE_PERIOD=10
