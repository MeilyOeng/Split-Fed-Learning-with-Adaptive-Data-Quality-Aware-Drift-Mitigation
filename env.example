# =============================================================================
# Split-Fed Learning — Environment Variables Reference
# =============================================================================
#
# HOW TO USE THIS FILE
# --------------------
# For local development:
#   source .env.example          (bash/zsh)
#   export $(cat .env.example | grep -v '#' | xargs)
#
# For Docker:
#   docker run --env-file .env.example ...
#
# For Kubernetes:
#   Copy the relevant section into a ConfigMap YAML.
#   Secret values (passwords, tokens) should go into a K8s Secret instead.
#
# IMPORTANT RULE:  Any variable that appears in BOTH client and server sections
# must have the SAME value on both sides.  If MODEL_HIDDEN_SIZE=64 on the
# server but MODEL_HIDDEN_SIZE=32 on the client, the tensor shapes at the
# split point won't match and training will crash immediately.
# =============================================================================


# =============================================================================
# SECTION 1 — SHARED MODEL ARCHITECTURE
# These MUST be identical on the client AND the server.
# =============================================================================

# Number of input features per timestep.
# For univariate time-series (one measurement per timestamp) this is 1.
# If you add more features (e.g. temperature + pressure) increase this.
MODEL_INPUT_SIZE=1

# Number of hidden units in each LSTM layer.
# Larger = more capacity but slower training and more memory.
MODEL_HIDDEN_SIZE=64

# Total number of LSTM layers in the full model (client + server combined).
MODEL_NUM_LAYERS=4

# At which layer to split the model between client and server.
# Example: MODEL_NUM_LAYERS=4, MODEL_SPLIT_LAYER=2
#   → client runs layers 1-2, server runs layers 3-4 + output head
# Must satisfy: 1 <= MODEL_SPLIT_LAYER < MODEL_NUM_LAYERS
MODEL_SPLIT_LAYER=2

# Size of the final prediction output.
# 1 = predict a single value (standard for univariate forecasting).
MODEL_OUTPUT_SIZE=1

# Dropout rate applied between LSTM layers (0.0 = no dropout).
# Helps prevent overfitting.  Good starting values: 0.0 – 0.3.
MODEL_DROPOUT=0.0

# Whether to use bidirectional LSTMs.
# Bidirectional means the LSTM reads the sequence forwards AND backwards.
# Only useful if you have the full sequence at inference time (not streaming).
MODEL_BIDIRECTIONAL=false


# =============================================================================
# SECTION 2 — DATA & WINDOWING
# These MUST be identical on the stream service AND the client.
# =============================================================================

# How many past timesteps the model sees as input for one prediction.
# Example: WINDOW_SIZE=24 means "use the last 24 hours to predict the future".
WINDOW_SIZE=24

# How many timesteps ahead to predict.
# FORECAST_HORIZON=1 → predict the very next value after the window.
# FORECAST_HORIZON=6 → predict the value 6 steps after the end of the window.
FORECAST_HORIZON=1

# Train / validation / test split ratios.
# Must sum to 1.0.  70% train / 15% val / 15% test is a reasonable default.
TRAIN_RATIO=0.7
VAL_RATIO=0.15
TEST_RATIO=0.15

# Whether to normalise X and y before sending them to the client.
# Normalisation is computed only on training data to prevent data leakage.
NORMALIZE=false

# "zscore" (subtract mean, divide by std) or "minmax" (scale to [0,1]).
NORMALIZE_METHOD=zscore

# Small number added to std/range to avoid division by zero.
NORMALIZE_EPS=1e-8


# =============================================================================
# SECTION 3 — STREAM SERVICE
# =============================================================================

# Which cluster this stream service instance serves.
# When running in Kubernetes, each stream-service pod sets its own value:
#   stream-svc-0 → STREAM_CLUSTER_ID=0
#   stream-svc-1 → STREAM_CLUSTER_ID=1
#   stream-svc-2 → STREAM_CLUSTER_ID=2
# Leave empty to serve ALL clusters (useful for local development).
STREAM_CLUSTER_ID=0

# Port the stream service listens on.
STREAM_PORT=5001

# Absolute path to the directory containing cluster_*.pkl files.
# In Kubernetes this will be the mount path of your PersistentVolume.
CLUSTER_DIR=/mnt/shared/data/dataset/output


# =============================================================================
# SECTION 4 — SERVER
# =============================================================================

# Which cluster this server handles.
# In Kubernetes each server pod sets its own:
#   server-0 → CLUSTER_ID=0
#   server-1 → CLUSTER_ID=1
CLUSTER_ID=0

# Port the server Flask app listens on.
SERVER_PORT=5002

# Learning rate for the server-side Adam optimiser.
LEARNING_RATE=0.001

# How often (in training steps) to save a server checkpoint.
# Example: CHECKPOINT_EVERY=500 → save every 500 batches processed.
CHECKPOINT_EVERY=500

# Directory where server checkpoints and logs are written.
# In Kubernetes this should be on a PersistentVolume so checkpoints
# survive pod restarts.
OUTPUT_DIR=/mnt/shared/output

# Optional: URL of an external clustering/drift-detection API.
# Leave empty to disable drift detection.
CLUSTERING_API_URL=

# Smoothing factor for the Exponential Moving Average used to track
# per-client gradient statistics.  Range: (0, 1).
# Closer to 1 = more weight on recent values (reacts faster to drift).
# Closer to 0 = more weight on history (smoother, slower to react).
EMA_ALPHA_GRADIENT=0.1
EMA_ALPHA_ERROR=0.1


# =============================================================================
# SECTION 5 — CLIENT
# =============================================================================

# Unique identifier for this client.
# Can be a numeric string ("9900002") or "client_N" format.
CLIENT_ID=9900002

# Which cluster this client belongs to.
# Ignored if CLIENT_ID is in "client_N" format (cluster is derived from N).
# CLUSTER_ID=0     ← already set in Section 4 above; reuse it

# Number of clients per cluster (used to derive cluster from "client_N" IDs).
NUM_CLIENTS_PER_CLUSTER=3

# Total number of clusters in the system.
NUM_CLUSTERS=3

# Training hyperparameters.
BATCH_SIZE=32
NUM_EPOCHS=5

# Learning rate for the client-side Adam optimiser.
# LEARNING_RATE=0.001  ← already set in Section 4; reuse it

# URL of the stream service this client pulls data from.
# In Kubernetes: http://stream-svc-0:5001  (Kubernetes Service name)
# Locally:       http://localhost:5001
DATA_STREAM_API_URL=http://localhost:5001

# Set to "true" to use localhost URLs (local development).
# Set to "false" in Kubernetes — the client will use K8s Service DNS names.
USE_LOCALHOST=true

# Port the client exposes Prometheus metrics on.
# Each client pod in K8s needs a DIFFERENT port, or use separate pods.
CLIENT_METRICS_PORT=9100

# Random seed for reproducibility.
# Set to the same value on client and server to get consistent results.
RANDOM_SEED=42

# Root path for data (used for logging/config; actual data comes from stream service).
DATA_ROOT=/mnt/shared/data


# =============================================================================
# SECTION 6 — KUBERNETES-SPECIFIC OVERRIDES
# =============================================================================
# When deploying to Kubernetes, override these values in your ConfigMap:
#
# For cluster 0:
#   STREAM_CLUSTER_ID=0
#   CLUSTER_ID=0
#   DATA_STREAM_API_URL=http://stream-svc-0:5001
#   SERVER_PORT=5002
#   USE_LOCALHOST=false
#   CLUSTER_DIR=/mnt/shared/data/dataset/output
#   OUTPUT_DIR=/mnt/shared/output
#
# For cluster 1:
#   STREAM_CLUSTER_ID=1
#   CLUSTER_ID=1
#   DATA_STREAM_API_URL=http://stream-svc-1:5001
#   SERVER_PORT=5002
#   USE_LOCALHOST=false
#   (CLUSTER_DIR and OUTPUT_DIR same as above — same shared volume)
#
# For cluster 2:
#   STREAM_CLUSTER_ID=2
#   CLUSTER_ID=2
#   DATA_STREAM_API_URL=http://stream-svc-2:5001
#   (everything else same)
#
# Each CLIENT pod also needs:
#   CLIENT_ID=<id from cluster-assignment.csv>
#   CLUSTER_ID=<0|1|2>
#   DATA_STREAM_API_URL=http://stream-svc-<cluster_id>:5001
#   USE_LOCALHOST=false
#   CLIENT_METRICS_PORT=9100   (all client pods can use 9100 since they're separate pods)
